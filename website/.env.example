# Vercel project -> Settings -> Environment Variables (do not commit real secrets)
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=xarmoured.tech,www.xarmoured.tech
RESEND_API_KEY=
# Must be an actual inbox you control (no invented destination)
CONTACT_TO_EMAIL=
# Must be a Resend-verified sending identity e.g. Enquiries <noreply@your-verified-domain>
CONTACT_FROM_EMAIL=
# The PUBLIC Turnstile site key belongs in assets/site-config.js
